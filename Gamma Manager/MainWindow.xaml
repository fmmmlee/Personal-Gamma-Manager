<Window x:Class="Gamma_Manager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Gamma Manager"
        Width="860" Height="360"
        MinWidth="700" MinHeight="320"
        Background="Transparent"
        Foreground="{StaticResource Fg}"
        FontFamily="{StaticResource AppFont}"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Loaded="OnWindowLoaded"
        Closing="OnWindowClosing">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="-1"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============================ TITLE BAR ============================ -->
        <Grid Grid.Row="0" Background="Transparent">
            <TextBlock Text="Gamma Manager"
                       Margin="16,0,0,0"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource FgMuted}"
                       VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="BtnMinimize"
                        Style="{StaticResource WindowCircleButton}"
                        Background="{StaticResource WinBtnMinBrush}"
                        Click="OnMinimizeClick"
                        ToolTip="Minimize"/>
                <Button x:Name="BtnMaximize"
                        Style="{StaticResource WindowCircleButton}"
                        Background="{StaticResource WinBtnMaxBrush}"
                        Click="OnMaximizeClick"
                        ToolTip="Maximize"/>
                <Button x:Name="BtnClose"
                        Style="{StaticResource WindowCircleButton}"
                        Background="{StaticResource WinBtnCloseBrush}"
                        Click="OnCloseClick"
                        ToolTip="Hide to tray"/>
            </StackPanel>
        </Grid>

        <!-- ============================ BODY ============================ -->
        <Grid Grid.Row="1" Margin="20,0,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="380"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="220"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== LEFT: sliders (gamma, brightness, contrast, monitor contrast) ===== -->
            <Grid Grid.Column="0" Grid.Row="0" Grid.RowSpan="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="64"/>
                </Grid.ColumnDefinitions>

                <!-- Gamma -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Gamma" Margin="0,8,0,8"/>
                <Slider x:Name="SliderGamma" Grid.Row="0" Grid.Column="1"
                        Minimum="30" Maximum="440" Value="100"
                        SmallChange="5" LargeChange="10"
                        Margin="0,8,12,8"
                        ValueChanged="OnSliderGammaChanged"/>
                <TextBox x:Name="TextGamma" Grid.Row="0" Grid.Column="2"
                         KeyDown="OnTextBoxKeyDown" LostFocus="OnTextGammaCommit"/>

                <!-- Brightness -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Brightness" Margin="0,8,0,8"/>
                <Slider x:Name="SliderBrightness" Grid.Row="1" Grid.Column="1"
                        Minimum="-100" Maximum="100" Value="0"
                        SmallChange="5" LargeChange="10"
                        Margin="0,8,12,8"
                        ValueChanged="OnSliderBrightnessChanged"/>
                <TextBox x:Name="TextBrightness" Grid.Row="1" Grid.Column="2"
                         KeyDown="OnTextBoxKeyDown" LostFocus="OnTextBrightnessCommit"/>

                <!-- Contrast -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Contrast" Margin="0,8,0,8"/>
                <Slider x:Name="SliderContrast" Grid.Row="2" Grid.Column="1"
                        Minimum="10" Maximum="300" Value="100"
                        SmallChange="5" LargeChange="10"
                        Margin="0,8,12,8"
                        ValueChanged="OnSliderContrastChanged"/>
                <TextBox x:Name="TextContrast" Grid.Row="2" Grid.Column="2"
                         KeyDown="OnTextBoxKeyDown" LostFocus="OnTextContrastCommit"/>

                <!-- Monitor contrast (DDC/CI; only visible for external monitors) -->
                <TextBlock x:Name="LabelMonitorContrast" Grid.Row="3" Grid.Column="0"
                           Text="Monitor&#x0a;Contrast" Margin="0,8,0,8"/>
                <Slider x:Name="SliderMonitorContrast" Grid.Row="3" Grid.Column="1"
                        Minimum="0" Maximum="100" Value="50"
                        SmallChange="1" LargeChange="5"
                        Margin="0,8,12,8"
                        ValueChanged="OnSliderMonitorContrastChanged"/>
                <TextBox x:Name="TextMonitorContrast" Grid.Row="3" Grid.Column="2"
                         KeyDown="OnTextBoxKeyDown" LostFocus="OnTextMonitorContrastCommit"/>
            </Grid>

            <!-- ===== MIDDLE: colour channel pills ===== -->
            <StackPanel Grid.Column="1" Grid.Row="0" Grid.RowSpan="2"
                        Orientation="Vertical"
                        VerticalAlignment="Top"
                        Margin="16,8,16,0">
                <Button x:Name="BtnAllColors" Content="All Colours"
                        Style="{StaticResource PillButtonActive}"
                        Width="100" Margin="0,0,0,8"
                        Click="OnAllColorsClick"/>
                <Button x:Name="BtnRed" Content="Red"
                        Style="{StaticResource PillButton}"
                        Width="100" Margin="0,0,0,8"
                        Click="OnRedClick"/>
                <Button x:Name="BtnGreen" Content="Green"
                        Style="{StaticResource PillButton}"
                        Width="100" Margin="0,0,0,8"
                        Click="OnGreenClick"/>
                <Button x:Name="BtnBlue" Content="Blue"
                        Style="{StaticResource PillButton}"
                        Width="100"
                        Click="OnBlueClick"/>
            </StackPanel>

            <!-- ===== RIGHT: monitor / preset card + buttons ===== -->
            <Grid Grid.Column="2" Grid.Row="0" Grid.RowSpan="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ComboBox x:Name="ComboMonitors" Grid.Row="0"
                          Margin="0,8,0,8"
                          SelectionChanged="OnMonitorChanged"/>

                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="ComboPresets" Grid.Column="0"
                              IsEditable="True"
                              SelectionChanged="OnPresetChanged"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                        <Button Content="Save" Style="{StaticResource PillButton}"
                                Margin="0,0,6,0" Click="OnSaveClick"/>
                        <Button Content="Delete" Style="{StaticResource PillButton}"
                                Click="OnDeleteClick"/>
                    </StackPanel>
                </Grid>

                <CheckBox x:Name="ChkUnlockContrast" Grid.Row="2"
                          Content="Unlock max contrast"
                          Margin="0,0,0,8"
                          Checked="OnUnlockContrastChanged"
                          Unchecked="OnUnlockContrastChanged"/>

                <Grid Grid.Row="3" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Reset"
                            Style="{StaticResource PillButton}"
                            Margin="0,0,4,0"
                            Click="OnResetClick"/>
                    <Button Grid.Column="1" Content="Hide"
                            Style="{StaticResource PillButton}"
                            Margin="4,0,0,0"
                            Click="OnHideClick"/>
                </Grid>
            </Grid>

            <!-- ===== FOOTER: separator + auto-switch row ===== -->
            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                    Height="1" Background="{StaticResource BorderBrushBase}"
                    Margin="0,8,0,8" VerticalAlignment="Top"/>

            <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="ChkRunOnStartup" Grid.Column="0"
                          Content="Run on startup"
                          Checked="OnRunOnStartupChanged"
                          Unchecked="OnRunOnStartupChanged"/>
                <CheckBox x:Name="ChkAutoSwitch" Grid.Column="2"
                          Content="HDR auto-switch"
                          Checked="OnAutoSwitchChanged"
                          Unchecked="OnAutoSwitchChanged"/>
                <TextBlock Grid.Column="4" Text="SDR:" Margin="12,0,8,0"
                           Foreground="{StaticResource FgMuted}"/>
                <ComboBox x:Name="ComboSdrProfile" Grid.Column="5"
                          MinWidth="140"
                          SelectionChanged="OnSdrProfileChanged"/>
                <TextBlock Grid.Column="6" Text="HDR:" Margin="12,0,8,0"
                           Foreground="{StaticResource FgMuted}"/>
                <ComboBox x:Name="ComboHdrProfile" Grid.Column="7"
                          MinWidth="140"
                          SelectionChanged="OnHdrProfileChanged"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
